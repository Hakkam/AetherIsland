<UserControl x:Class="AetherIsland.App.Views.FileShelfView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AllowDrop="True" Drop="View_Drop" DragOver="View_DragOver">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Margin="2,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding CountText}" Style="{DynamicResource Muted}" VerticalAlignment="Center" Margin="2,0,10,0" />
            <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" MaxWidth="240"
                     HorizontalAlignment="Right" />
            <Button Grid.Column="2" Style="{DynamicResource DangerButton}" Content="{Binding ClearLabel}"
                    Command="{Binding ClearAllCommand}" Padding="10,5" FontSize="11" Margin="8,0,0,0" />
        </Grid>

        <Grid Grid.Row="1">
            <!-- empty state -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding EmptyVisible, Converter={StaticResource BoolToVis}}">
                <Border Width="230" Height="140" CornerRadius="16"
                        BorderBrush="{DynamicResource MutedBrush}" BorderThickness="1.5" Opacity="0.9">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="&#xE8B7;" FontFamily="{DynamicResource GlyphFont}" FontSize="30"
                                   Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding EmptyTitle}" FontSize="12.5" Foreground="{DynamicResource Text2Brush}"
                                   HorizontalAlignment="Center" Margin="0,10,0,0" />
                        <TextBlock Text="{Binding EmptyHint}" FontSize="10" Foreground="{DynamicResource MutedBrush}"
                                   HorizontalAlignment="Center" Margin="0,5,0,0" TextWrapping="Wrap" MaxWidth="190"
                                   TextAlignment="Center" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- items -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding HasItems, Converter={StaticResource BoolToVis}}">
                <ItemsControl ItemsSource="{Binding Filtered}" x:Name="ItemsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="10,7"
                                    BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" Margin="0,0,0,5"
                                    MouseMove="Item_MouseMove" MouseLeftButtonDown="Item_MouseLeftButtonDown" Cursor="Hand">
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="{Binding OpenLabel}" Command="{Binding OpenCommand}" />
                                        <MenuItem Header="{Binding RevealLabel}" Command="{Binding RevealCommand}" />
                                        <MenuItem Header="{Binding CopyPathLabel}" Command="{Binding CopyPathCommand}" />
                                        <MenuItem Header="{Binding CopyFileLabel}" Command="{Binding CopyFileCommand}" />
                                        <Separator />
                                        <MenuItem Header="{Binding RemoveLabel}" Command="{Binding RemoveCommand}" />
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="40" Height="40" CornerRadius="8" Background="{DynamicResource Surface2Brush}">
                                        <Grid>
                                            <Image Source="{Binding Thumbnail}" Stretch="Uniform" Margin="4" />
                                            <TextBlock Text="&#xE8B7;" FontFamily="{DynamicResource GlyphFont}" FontSize="16"
                                                       Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Visibility="{Binding NoThumb, Converter={StaticResource BoolToVis}}" />
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="12" Foreground="{DynamicResource TextBrush}"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="430" HorizontalAlignment="Left" />
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <TextBlock Text="{Binding SizeText}" FontSize="9.5" Foreground="{DynamicResource MutedBrush}" />
                                            <TextBlock Text=" · " FontSize="9.5" Foreground="{DynamicResource MutedBrush}" />
                                            <TextBlock Text="{Binding AddedText}" FontSize="9.5" Foreground="{DynamicResource MutedBrush}" />
                                            <TextBlock Text="{Binding MissingText}" FontSize="9.5" Foreground="{DynamicResource DangerBrush}"
                                                       Margin="10,0,0,0"
                                                       Visibility="{Binding IsMissing, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <Button Grid.Column="2" Style="{DynamicResource IconButton}" Content="&#xE74D;" Width="28" Height="26"
                                            Command="{Binding RemoveCommand}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
