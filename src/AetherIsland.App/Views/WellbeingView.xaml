<UserControl x:Class="AetherIsland.App.Views.WellbeingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <UniformGrid Columns="3" Margin="2,4">
        <!-- hydration -->
        <Border Style="{DynamicResource WidgetCard}" Margin="0,0,5,0">
            <StackPanel>
                <TextBlock Text="{Binding HydrationTitle}" Style="{DynamicResource Muted}" />
                <TextBlock Text="{Binding HydrationText}" Style="{DynamicResource Numeric}" FontSize="26"
                           FontWeight="SemiBold" Margin="0,6,0,2" />
                <TextBlock Text="{Binding GoalText}" Style="{DynamicResource Muted}" />
                <ProgressBar Style="{DynamicResource SlimProgress}" Value="{Binding HydrationFraction, Mode=OneWay}"
                             Maximum="1" Margin="0,10,0,0" />
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Style="{DynamicResource PrimaryButton}" Content="{Binding AddCupLabel}"
                            Command="{Binding AddCupCommand}" Padding="12,6" />
                    <Button Style="{DynamicResource GhostButton}" Content="{Binding ResetLabel}"
                            Command="{Binding ResetCommand}" Padding="10,6" Margin="6,0,0,0" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- reminders -->
        <Border Style="{DynamicResource WidgetCard}" Margin="5,0">
            <StackPanel>
                <TextBlock Text="{Binding RemindersTitle}" Style="{DynamicResource Muted}" />
                <StackPanel Margin="0,8,0,0">
                    <TextBlock Text="{Binding EyeTitle}" FontSize="11.5" Foreground="{DynamicResource TextBrush}" />
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBlock Text="{Binding EyeEveryText}" FontSize="10" Foreground="{DynamicResource MutedBrush}" />
                        <TextBlock Text="{Binding NextEyeText}" FontSize="10" Foreground="{DynamicResource Text2Brush}"
                                   Margin="10,0,0,0" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Margin="0,12,0,0">
                    <TextBlock Text="{Binding MoveTitle}" FontSize="11.5" Foreground="{DynamicResource TextBrush}" />
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBlock Text="{Binding MoveEveryText}" FontSize="10" Foreground="{DynamicResource MutedBrush}" />
                        <TextBlock Text="{Binding NextMoveText}" FontSize="10" Foreground="{DynamicResource Text2Brush}"
                                   Margin="10,0,0,0" />
                    </StackPanel>
                </StackPanel>
                <TextBlock Text="{Binding StreakText}" FontSize="10.5" Foreground="{DynamicResource SuccessBrush}" Margin="0,14,0,0" />
            </StackPanel>
        </Border>

        <!-- breathing -->
        <Border Style="{DynamicResource WidgetCard}" Margin="5,0,0,0">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding BreathingTitle}" Style="{DynamicResource Muted}" />
                <TextBlock Text="{Binding BreathPhase}" FontSize="19" FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentDynamicBrush}" HorizontalAlignment="Center"
                           Margin="0,14,0,0" />
                <ProgressBar Style="{DynamicResource SlimProgress}" Value="{Binding BreathFraction, Mode=OneWay}"
                             Maximum="1" Margin="0,12,0,0" />
                <Button Style="{DynamicResource GhostButton}" HorizontalAlignment="Center" Margin="0,14,0,0"
                        Command="{Binding StartBreathingCommand}" Padding="12,6">
                    <TextBlock Text="{Binding BreathButtonLabel}" FontSize="11.5" />
                </Button>
            </StackPanel>
        </Border>
    </UniformGrid>
</UserControl>
