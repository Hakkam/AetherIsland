<UserControl x:Class="AetherIsland.App.Views.ProductivityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Margin="2,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- consent gate -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" CornerRadius="12" Padding="16"
                BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1"
                Visibility="{Binding ConsentNeeded, Converter={StaticResource BoolToVis}}" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="{Binding ConsentTitle}" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                <TextBlock Text="{Binding ConsentBody}" FontSize="11.5" TextWrapping="Wrap" MaxWidth="560"
                           Foreground="{DynamicResource Text2Brush}" Margin="0,8,0,0" />
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Style="{DynamicResource PrimaryButton}" Content="{Binding AcceptLabel}"
                            Command="{Binding AcceptConsentCommand}" />
                    <Button Style="{DynamicResource GhostButton}" Content="{Binding DeclineLabel}"
                            Command="{Binding DeclineConsentCommand}" Margin="8,0,0,0" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- paused banner -->
        <Border Grid.Row="0" Background="{DynamicResource Surface2Brush}" CornerRadius="10" Padding="10,7"
                Visibility="{Binding PausedVisible, Converter={StaticResource BoolToVis}}" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE9D5;" FontFamily="{DynamicResource GlyphFont}" FontSize="13"
                           Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding PausedText}" FontSize="11.5" Foreground="{DynamicResource Text2Brush}"
                           VerticalAlignment="Center" Margin="8,0,0,0" />
                <Button Style="{DynamicResource GhostButton}" Content="{Binding EnableLabel}" Padding="8,3" FontSize="10.5"
                        Command="{Binding AcceptConsentCommand}" Margin="10,0,0,0" />
            </StackPanel>
        </Border>

        <!-- main -->
        <Grid Grid.Row="1" Visibility="{Binding DataVisible, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Margin="2,0,2,10">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding TotalTodayText}" Style="{DynamicResource Numeric}" FontSize="26" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding TotalTodayLabel}" FontSize="11" Foreground="{DynamicResource Text2Brush}"
                               VerticalAlignment="Bottom" Margin="8,0,14,5" />
                    <TextBlock Text="{Binding CurrentAppText}" FontSize="11" Foreground="{DynamicResource Text2Brush}"
                               VerticalAlignment="Center" MaxWidth="200" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding SwitchesText}" FontSize="11" Foreground="{DynamicResource MutedBrush}"
                               VerticalAlignment="Center" Margin="12,0,0,0" />
                    <TextBlock Text="{Binding IdleNote}" FontSize="11" Foreground="{DynamicResource WarningBrush}"
                               VerticalAlignment="Center" Margin="10,0,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{DynamicResource GhostButton}" Content="{Binding RangeTodayLabel}" Padding="8,3" FontSize="10.5"
                            Command="{Binding RangeCommand}" CommandParameter="today" Margin="2,0" />
                    <Button Style="{DynamicResource GhostButton}" Content="{Binding Range7Label}" Padding="8,3" FontSize="10.5"
                            Command="{Binding RangeCommand}" CommandParameter="days7" Margin="2,0" />
                    <Button Style="{DynamicResource GhostButton}" Content="{Binding Range30Label}" Padding="8,3" FontSize="10.5"
                            Command="{Binding RangeCommand}" CommandParameter="days30" Margin="2,0" />
                    <Button Style="{DynamicResource IconButton}" Content="&#xE74D;" Command="{Binding DeleteHistoryCommand}"
                            ToolTip="{Binding DeleteLabel}" Margin="4,0,0,0" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- by category -->
                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock Text="{Binding ByCategoryLabel}" Style="{DynamicResource SectionTitle}" />
                    <ItemsControl ItemsSource="{Binding ByCategory}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,7">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="8" Height="8" CornerRadius="4" Background="{Binding Brush}"
                                                    VerticalAlignment="Center" Margin="0,0,7,0" />
                                            <TextBlock Text="{Binding Label}" FontSize="11" Foreground="{DynamicResource Text2Brush}" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding TimeText}" Style="{DynamicResource Numeric}" FontSize="11"
                                                   HorizontalAlignment="Right" />
                                    </Grid>
                                    <ProgressBar Style="{DynamicResource SlimProgress}" Value="{Binding Fraction, Mode=OneWay}"
                                                 Maximum="1" Margin="0,4,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- top apps -->
                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                    <TextBlock Text="{Binding TopAppsLabel}" Style="{DynamicResource SectionTitle}" />
                    <ItemsControl ItemsSource="{Binding TopApps}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,7">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Rank}" Style="{DynamicResource Numeric}" FontSize="10.5"
                                                       Foreground="{DynamicResource MutedBrush}" Width="18" />
                                            <TextBlock Text="{Binding DisplayName}" FontSize="11" Foreground="{DynamicResource TextBrush}"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="170" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding TimeText}" Style="{DynamicResource Numeric}" FontSize="11"
                                                   HorizontalAlignment="Right" />
                                    </Grid>
                                    <ProgressBar Style="{DynamicResource SlimProgress}" Value="{Binding Fraction, Mode=OneWay}"
                                                 Maximum="1" Margin="0,4,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
