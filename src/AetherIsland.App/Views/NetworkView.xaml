<UserControl x:Class="AetherIsland.App.Views.NetworkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Margin="2,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Wi-Fi -->
        <StackPanel Grid.Column="0" Margin="0,0,8,0">
            <Grid Margin="0,0,0,6">
                <TextBlock Text="{Binding WifiTitle}" Style="{DynamicResource SectionTitle}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{DynamicResource IconButton}" Content="&#xE72C;" Command="{Binding RefreshCommand}" />
                    <Button Style="{DynamicResource IconButton}" Content="&#xE713;" Command="{Binding OpenSettingsCommand}"
                            ToolTip="{Binding OpenSettingsLabel}" />
                </StackPanel>
            </Grid>

            <!-- current -->
            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="12" Padding="12"
                    BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" Margin="0,0,0,10"
                    Visibility="{Binding HasCurrentNetwork, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE701;" FontFamily="{DynamicResource GlyphFont}" FontSize="16"
                                   Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding CurrentSsid}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}" Margin="9,0,0,0" />
                        <TextBlock Text="{Binding CurrentSecureText}" FontSize="10" Foreground="{DynamicResource MutedBrush}"
                                   VerticalAlignment="Center" Margin="8,0,0,0" />
                    </StackPanel>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding SignalLabel}" Style="{DynamicResource Muted}" VerticalAlignment="Center" />
                        <ProgressBar Grid.Column="1" Style="{DynamicResource SlimProgress}" Value="{Binding CurrentSignal, Mode=OneWay}"
                                     Maximum="1" Margin="8,0" />
                        <TextBlock Grid.Column="2" Text="{Binding CurrentSignalText}" Style="{DynamicResource Numeric}" FontSize="11" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="{Binding IpLabel}" Style="{DynamicResource Muted}" />
                        <TextBlock Text="{Binding IpText}" Style="{DynamicResource Numeric}" FontSize="11" Margin="8,0,0,0" />
                        <Button Style="{DynamicResource GhostButton}" Content="{Binding DisconnectLabel}" Padding="8,3" FontSize="10.5"
                                Command="{Binding DisconnectCommand}" Margin="12,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding AvailableLabel}" Style="{DynamicResource SectionTitle}" />
            <TextBlock Text="{Binding NoAdapterText}" FontSize="11.5" Foreground="{DynamicResource MutedBrush}"
                       Margin="2,6,0,0"
                       Visibility="{Binding NoAdapterVisible, Converter={StaticResource BoolToVis}}" />
            <TextBlock Text="{Binding RadioOffText}" FontSize="11.5" Foreground="{DynamicResource MutedBrush}"
                       Margin="2,6,0,0"
                       Visibility="{Binding RadioOffVisible, Converter={StaticResource BoolToVis}}" />

            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="230">
                <ItemsControl ItemsSource="{Binding Available}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="9" Padding="9,6"
                                    BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" Margin="0,0,0,5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding SignalGlyph}" FontFamily="{DynamicResource GlyphFont}" FontSize="13"
                                               Foreground="{DynamicResource AccentDynamicBrush}" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Margin="9,0,0,0">
                                        <TextBlock Text="{Binding Ssid}" FontSize="11.5" Foreground="{DynamicResource TextBrush}"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="200" HorizontalAlignment="Left" />
                                        <TextBlock FontSize="9" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Left">
                                            <Run Text="{Binding SignalPercent, Mode=OneWay}" /><Run Text="%" />
                                            <Run Text=" · " /><Run Text="{Binding SecureText, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <Button Grid.Column="2" Style="{DynamicResource GhostButton}" Content="{Binding DataContext.ConnectLabel, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            Command="{Binding DataContext.ConnectCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" Padding="8,3" FontSize="10" Margin="0,0,5,0" />
                                    <TextBlock Grid.Column="3" Text="&#xE73E;" FontFamily="{DynamicResource GlyphFont}" FontSize="13"
                                               Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center"
                                               Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </StackPanel>

        <!-- Bluetooth -->
        <StackPanel Grid.Column="1" Margin="8,0,0,0">
            <Grid Margin="0,0,0,6">
                <TextBlock Text="{Binding BluetoothTitle}" Style="{DynamicResource SectionTitle}" />
                <Button Style="{DynamicResource IconButton}" Content="&#xE713;" HorizontalAlignment="Right"
                        Command="{Binding OpenBluetoothSettingsCommand}" ToolTip="{Binding OpenSettingsLabel}" />
            </Grid>
            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="12" Padding="12"
                    BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE702;" FontFamily="{DynamicResource GlyphFont}" FontSize="16"
                                   Foreground="{DynamicResource AccentDynamicBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding BluetoothStateText}" FontSize="12" Foreground="{DynamicResource TextBrush}"
                                   VerticalAlignment="Center" Margin="9,0,0,0" />
                    </StackPanel>
                    <TextBlock Text="{Binding DevicesNote}" FontSize="10" Foreground="{DynamicResource MutedBrush}"
                               Margin="0,6,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <TextBlock Text="{Binding DevicesLabel}" Style="{DynamicResource SectionTitle}" Margin="0,10,0,0" />
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="240">
                <ItemsControl ItemsSource="{Binding BluetoothDevices}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="9" Padding="9,6"
                                    BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" Margin="0,0,0,5">
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontSize="11.5" Foreground="{DynamicResource TextBrush}" />
                                        <TextBlock Text="{Binding StateText}" FontSize="9.5" Foreground="{DynamicResource MutedBrush}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding BatteryText}" Style="{DynamicResource Numeric}" FontSize="11"
                                               VerticalAlignment="Center" HorizontalAlignment="Right" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </StackPanel>
    </Grid>
</UserControl>
