<UserControl x:Class="AetherIsland.App.Views.FocusView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,6,0,0">
        <!-- mode selector -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,14">
            <Button Style="{DynamicResource GhostButton}" Content="{Binding WorkLabel}" Margin="3,0" Padding="10,5"
                    Command="{Binding SwitchModeCommand}" CommandParameter="work" />
            <Button Style="{DynamicResource GhostButton}" Content="{Binding ShortBreakLabel}" Margin="3,0" Padding="10,5"
                    Command="{Binding SwitchModeCommand}" CommandParameter="short" />
            <Button Style="{DynamicResource GhostButton}" Content="{Binding LongBreakLabel}" Margin="3,0" Padding="10,5"
                    Command="{Binding SwitchModeCommand}" CommandParameter="long" />
            <Button Style="{DynamicResource GhostButton}" Content="{Binding CustomLabel}" Margin="3,0" Padding="10,5"
                    Command="{Binding SwitchModeCommand}" CommandParameter="custom" />
            <Button Style="{DynamicResource GhostButton}" Content="{Binding StopwatchLabel}" Margin="3,0" Padding="10,5"
                    Command="{Binding SwitchModeCommand}" CommandParameter="stopwatch" />
        </StackPanel>

        <TextBlock Text="{Binding CurrentModeLabel}" FontSize="12" Foreground="{DynamicResource Text2Brush}"
                   HorizontalAlignment="Center" Margin="0,0,0,6" />

        <TextBlock Text="{Binding RemainingText}" Style="{DynamicResource Numeric}" FontSize="46" FontWeight="SemiBold"
                   HorizontalAlignment="Center" />

        <ProgressBar Style="{DynamicResource SlimProgress}" Value="{Binding ProgressFraction, Mode=OneWay}"
                     Maximum="1" Width="300" Margin="0,12,0,0" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
            <Button Style="{DynamicResource PrimaryButton}" Content="{Binding StartPauseLabel}"
                    Command="{Binding StartPauseCommand}" MinWidth="110" />
            <Button Style="{DynamicResource GhostButton}" Content="{Binding ResetLabel}"
                    Command="{Binding ResetCommand}" Margin="8,0,0,0" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0"
                    Visibility="{Binding CustomVisible, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding CustomMinutesLabel}" FontSize="11" Foreground="{DynamicResource Text2Brush}"
                       VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox Text="{Binding CustomMinutes, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" Width="52" />
        </StackPanel>

        <TextBlock Text="{Binding SessionCountText}" Style="{DynamicResource Muted}" HorizontalAlignment="Center"
                   Margin="0,12,0,0" />
    </StackPanel>
</UserControl>
