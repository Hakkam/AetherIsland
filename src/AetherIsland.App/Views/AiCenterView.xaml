<UserControl x:Class="AetherIsland.App.Views.AiCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:AetherIsland.App.Infrastructure">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <infra:InverseBoolToVisibilityConverter x:Key="InvBoolToVis" />
        <Style x:Key="StatusDot" TargetType="Ellipse">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="2,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- header -->
        <Grid Grid.Row="0" Margin="2,0,2,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE653;" FontFamily="{DynamicResource GlyphFont}" FontSize="17"
                           Foreground="{DynamicResource AiBrush}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}" Margin="9,0,10,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding ConnectedCountText}" FontSize="11.5" VerticalAlignment="Center"
                           Foreground="{DynamicResource Text2Brush}" />
            </StackPanel>
            <TextBlock Grid.Column="1" Text="{Binding LastUpdatedText}" FontSize="10.5"
                       Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="8,0" />
            <Button Grid.Column="2" Style="{DynamicResource IconButton}" Content="&#xE72C;"
                    Command="{Binding RefreshCommand}" ToolTip="{Binding RefreshLabel}" />
            <Button Grid.Column="3" Style="{DynamicResource IconButton}" Content="&#xE713;"
                    Command="{Binding OpenAiSettingsCommand}" ToolTip="{Binding SettingsTooltip}" />
        </Grid>

        <!-- period selector -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,283,-8" Panel.ZIndex="2">
            <StackPanel.Resources>
                <Style x:Key="PeriodBtn" TargetType="Button" BasedOn="{StaticResource GhostButton}">
                    <Setter Property="Padding" Value="8,3" />
                    <Setter Property="FontSize" Value="10" />
                    <Setter Property="Margin" Value="3,0" />
                </Style>
            </StackPanel.Resources>
            <Button Style="{StaticResource PeriodBtn}" Content="{Binding PeriodBilling}" Command="{Binding SetPeriodCommand}" CommandParameter="billing" />
            <Button Style="{StaticResource PeriodBtn}" Content="{Binding PeriodToday}" Command="{Binding SetPeriodCommand}" CommandParameter="today" />
            <Button Style="{StaticResource PeriodBtn}" Content="{Binding Period24H}" Command="{Binding SetPeriodCommand}" CommandParameter="h24" />
            <Button Style="{StaticResource PeriodBtn}" Content="{Binding Period7D}" Command="{Binding SetPeriodCommand}" CommandParameter="d7" />
            <Button Style="{StaticResource PeriodBtn}" Content="{Binding Period30D}" Command="{Binding SetPeriodCommand}" CommandParameter="d30" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="275" />
            </Grid.ColumnDefinitions>

            <!-- provider cards -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,6,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="2,0,0,6">
                        <TextBlock Text="{Binding OfficialTotalsText}" FontSize="10.5" Foreground="{DynamicResource Text2Brush}" TextTrimming="CharacterEllipsis" MaxWidth="290" />
                        <TextBlock Text="   |   " FontSize="10.5" Foreground="{DynamicResource MutedBrush}" />
                        <TextBlock Text="{Binding LocalTotalsText}" FontSize="10.5" Foreground="{DynamicResource Text2Brush}" TextTrimming="CharacterEllipsis" MaxWidth="250" />
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding Providers}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="12"
                                        BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1"
                                        Padding="12" Margin="0,0,0,8" Cursor="Hand"
                                        MouseLeftButtonDown="ProviderCard_Click">
                                    <StackPanel>
                                        <!-- card head -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse>
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse" BasedOn="{StaticResource StatusDot}">
                                                        <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Connected}" Value="False">
                                                                <Setter Property="Fill" Value="{DynamicResource MutedBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <StackPanel Grid.Column="1" Margin="9,0,0,0">
                                                <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextBrush}" />
                                                <TextBlock Text="{Binding StatusText}" FontSize="10" TextTrimming="CharacterEllipsis"
                                                           MaxWidth="420" Foreground="{DynamicResource Text2Brush}" Margin="0,1,0,0" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding CostText}" Style="{DynamicResource Numeric}"
                                                       FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </Grid>

                                        <!-- core numbers -->
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding TokensTitle}" Style="{DynamicResource Muted}" FontSize="9.5" />
                                                <TextBlock Text="{Binding TokensText}" Style="{DynamicResource Numeric}" FontSize="12" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding RequestsTitle}" Style="{DynamicResource Muted}" FontSize="9.5" />
                                                <TextBlock Text="{Binding RequestsText}" Style="{DynamicResource Numeric}" FontSize="12" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="{Binding CostSourceTitle}" Style="{DynamicResource Muted}" FontSize="9.5" />
                                                <TextBlock Text="{Binding CostSourceLabel}" FontSize="10.5"
                                                           Foreground="{DynamicResource Text2Brush}" />
                                            </StackPanel>
                                        </Grid>

                                        <!-- quota lines -->
                                        <ItemsControl ItemsSource="{Binding QuotaLines}" Margin="0,9,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="0,0,0,7" Visibility="{Binding IsUnavailable, Converter={StaticResource InvBoolToVis}}">
                                                        <Grid>
                                                            <TextBlock Text="{Binding Label}" FontSize="10.5" Foreground="{DynamicResource Text2Brush}" />
                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                                <TextBlock Text="{Binding SourceLabel}" FontSize="9"
                                                                           Foreground="{DynamicResource MutedBrush}" Margin="0,0,8,0" />
                                                                <TextBlock Text="{Binding PercentText}" Style="{DynamicResource Numeric}" FontSize="11" />
                                                            </StackPanel>
                                                        </Grid>
                                                        <ProgressBar Style="{DynamicResource SlimProgress}" Value="{Binding Percent, Mode=OneWay}"
                                                                     Maximum="1" Margin="0,4,0,3" />
                                                        <Grid>
                                                            <TextBlock Text="{Binding UsedLimitText}" FontSize="9.5" Foreground="{DynamicResource MutedBrush}" />
                                                            <TextBlock Text="{Binding ResetText}" FontSize="9.5" Foreground="{DynamicResource MutedBrush}"
                                                                       HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" MaxWidth="260" />
                                                        </Grid>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <TextBlock Text="{Binding NotAvailableText}" FontSize="10" FontStyle="Italic"
                                                   Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,0"
                                                   Visibility="{Binding ShowNotAvailable, Converter={StaticResource BoolToVis}}" />

                                        <!-- by-model detail -->
                                        <ItemsControl ItemsSource="{Binding ModelRows}" Margin="0,8,0,0"
                                                      Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,3">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="2*" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding ModelId}" FontSize="10.5" Foreground="{DynamicResource Text2Brush}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="1" Text="{Binding InputText}" Style="{DynamicResource Numeric}" FontSize="10.5" HorizontalAlignment="Right" />
                                                        <TextBlock Grid.Column="2" Text="{Binding OutputText}" Style="{DynamicResource Numeric}" FontSize="10.5" HorizontalAlignment="Right" />
                                                        <TextBlock Grid.Column="3" Text="{Binding CostText}" Style="{DynamicResource Numeric}" FontSize="10.5" HorizontalAlignment="Right" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- empty state -->
                    <Border Visibility="{Binding NoProviders, Converter={StaticResource BoolToVis}}"
                            Background="{DynamicResource SurfaceBrush}" CornerRadius="12"
                            BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1"
                            Padding="24" HorizontalAlignment="Center" Margin="0,30">
                        <StackPanel>
                            <TextBlock Text="&#xE653;" FontFamily="{DynamicResource GlyphFont}" FontSize="30"
                                       Foreground="{DynamicResource AiBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding NoProvidersText}" FontSize="12" Foreground="{DynamicResource Text2Brush}"
                                       HorizontalAlignment="Center" Margin="0,10,0,0" />
                            <Button Style="{DynamicResource PrimaryButton}" Content="{Binding AddProviderLabel}"
                                    Command="{Binding OpenAiSettingsCommand}" Margin="0,12,0,0" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- right column: agents + dedup note -->
            <Border Grid.Column="1" Background="{DynamicResource SurfaceBrush}" CornerRadius="12"
                    BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{Binding AgentsTitle}" Style="{DynamicResource SectionTitle}" />
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Agents}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource Surface2Brush}" CornerRadius="9" Padding="9,7"
                                            Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="7" Height="7" Fill="{DynamicResource SuccessBrush}"
                                                             VerticalAlignment="Center" Margin="0,0,7,0">
                                                        <Ellipse.Style>
                                                            <Style TargetType="Ellipse">
                                                                <Setter Property="Fill" Value="{DynamicResource MutedBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding State}" Value="running">
                                                                        <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding State}" Value="waiting">
                                                                        <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding State}" Value="error">
                                                                        <Setter Property="Fill" Value="{DynamicResource DangerBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>
                                                    <TextBlock Text="{Binding Name}" FontSize="11.5" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextBrush}" />
                                                    <TextBlock Text="{Binding StateText}" FontSize="10.5" Margin="7,0,0,0"
                                                               Foreground="{DynamicResource Text2Brush}" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding Project}" FontSize="9.5" Foreground="{DynamicResource MutedBrush}"
                                                           Margin="14,2,0,0" TextTrimming="CharacterEllipsis" MaxWidth="200" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding DurationText}" Style="{DynamicResource Numeric}" FontSize="10.5" />
                                                <TextBlock Text="{Binding LastActivityText}" FontSize="9" Foreground="{DynamicResource MutedBrush}"
                                                           HorizontalAlignment="Right" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock Grid.Row="2" Text="{Binding DedupNote}" FontSize="9" TextWrapping="Wrap"
                               Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
