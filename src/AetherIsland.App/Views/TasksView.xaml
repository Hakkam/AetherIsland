<UserControl x:Class="AetherIsland.App.Views.TasksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <infra:StringEqualsConverter x:Key="StrEq" xmlns:infra="clr-namespace:AetherIsland.App.Infrastructure" />
    </UserControl.Resources>

    <Grid Margin="2,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- add + filters -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Text="{Binding NewTaskText, UpdateSourceTrigger=PropertyChanged}">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding AddTaskCommand}" />
                </TextBox.InputBindings>
            </TextBox>
            <Button Grid.Column="1" Style="{DynamicResource IconButton}" Content="&#xE710;" Margin="6,0,0,0"
                    Command="{Binding AddTaskCommand}" />
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
                <RadioButton Style="{DynamicResource NavItem}" GroupName="taskfilter" Content="&#xE8FD;"
                             ToolTip="{Binding ActiveLabel}"
                             IsChecked="{Binding SelectedFilter, Converter={StaticResource StrEq}, ConverterParameter=active, Mode=TwoWay}"
                             Command="{Binding SetFilterCommand}" CommandParameter="active" />
                <RadioButton Style="{DynamicResource NavItem}" GroupName="taskfilter" Content="&#xE73E;"
                             ToolTip="{Binding CompletedLabel}"
                             IsChecked="{Binding SelectedFilter, Converter={StaticResource StrEq}, ConverterParameter=completed, Mode=TwoWay}"
                             Command="{Binding SetFilterCommand}" CommandParameter="completed" />
                <RadioButton Style="{DynamicResource NavItem}" GroupName="taskfilter" Content="&#xE8A9;"
                             ToolTip="{Binding AllLabel}"
                             IsChecked="{Binding SelectedFilter, Converter={StaticResource StrEq}, ConverterParameter=all, Mode=TwoWay}"
                             Command="{Binding SetFilterCommand}" CommandParameter="all" />
                <TextBlock Text="{Binding ProgressLabel}" Style="{DynamicResource Muted}" VerticalAlignment="Center"
                           Margin="10,0,6,0" />
                <TextBlock Text="{Binding CompletedTodayCount}" Style="{DynamicResource Numeric}" FontSize="12"
                           VerticalAlignment="Center" />
                <ProgressBar Style="{DynamicResource SlimProgress}" Value="{Binding ProgressFraction, Mode=OneWay}"
                             Maximum="1" Width="90" VerticalAlignment="Center" Margin="8,0,0,0" />
            </StackPanel>
        </Grid>

        <!-- list -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="{Binding EmptyTextLabel}" HorizontalAlignment="Center" Margin="0,30,0,0"
                           FontSize="12" Foreground="{DynamicResource Text2Brush}"
                           Visibility="{Binding NoTasks, Converter={StaticResource BoolToVis}}" />

                <ItemsControl ItemsSource="{Binding Tasks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="9" Padding="10,7"
                                    BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" Margin="0,0,0,5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding IsDone, Mode=TwoWay}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="12.5" Margin="10,0,8,0"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextBrush}" MaxWidth="480">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                        <Setter Property="TextDecorations" Value="Strikethrough" />
                                                        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                                        <Border CornerRadius="5" Padding="6,2" Background="#33F2B45C"
                                                Visibility="{Binding IsHigh, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding PriorityLabel}" FontSize="9" Foreground="{DynamicResource WarningBrush}" />
                                        </Border>
                                        <Border CornerRadius="5" Padding="6,2" Background="#33737D8D"
                                                Visibility="{Binding IsLow, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding PriorityLabel}" FontSize="9" Foreground="{DynamicResource MutedBrush}" />
                                        </Border>
                                        <TextBlock Text="{Binding DueText}" FontSize="9.5" Foreground="{DynamicResource MutedBrush}"
                                                   VerticalAlignment="Center" Margin="8,0,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="3" Style="{DynamicResource IconButton}" Content="&#xE74D;" Width="28" Height="26"
                                            Command="{Binding DeleteCommand}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
