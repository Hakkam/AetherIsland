<UserControl x:Class="AetherIsland.App.Views.SystemView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Margin="2,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 2x2 metric cards -->
        <UniformGrid Grid.Row="0" Columns="2" Margin="0,0,0,10">
            <Border Style="{DynamicResource WidgetCard}" Margin="0,0,5,5">
                <StackPanel>
                    <TextBlock Text="{Binding CpuLabel}" Style="{DynamicResource Muted}" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,6">
                        <TextBlock Text="{Binding CpuText}" Style="{DynamicResource Numeric}" FontSize="24" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding TempLabel}" FontSize="10" Foreground="{DynamicResource MutedBrush}"
                                   VerticalAlignment="Bottom" Margin="10,0,0,6" />
                        <TextBlock Text="{Binding TempText}" FontSize="10.5" Foreground="{DynamicResource Text2Brush}"
                                   VerticalAlignment="Bottom" Margin="4,0,0,6" />
                    </StackPanel>
                    <ProgressBar Style="{DynamicResource SlimProgress}" Value="{Binding CpuPercent, Mode=OneWay}" Maximum="100" />
                </StackPanel>
            </Border>
            <Border Style="{DynamicResource WidgetCard}" Margin="5,0,0,5">
                <StackPanel>
                    <TextBlock Text="{Binding MemLabel}" Style="{DynamicResource Muted}" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,6">
                        <TextBlock Text="{Binding MemText}" Style="{DynamicResource Numeric}" FontSize="24" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding MemDetailText}" FontSize="10" Foreground="{DynamicResource MutedBrush}"
                                   VerticalAlignment="Bottom" Margin="10,0,0,6" />
                    </StackPanel>
                    <ProgressBar Style="{DynamicResource SlimProgress}" Value="{Binding MemPercent, Mode=OneWay}" Maximum="100" />
                </StackPanel>
            </Border>
            <Border Style="{DynamicResource WidgetCard}" Margin="0,5,5,0">
                <Grid>
                    <StackPanel Visibility="{Binding BatteryVisible, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <TextBlock Text="{Binding BatteryLabel}" Style="{DynamicResource Muted}" />
                            <TextBlock Text="{Binding ChargingText}" FontSize="9.5" Foreground="{DynamicResource SuccessBrush}"
                                       HorizontalAlignment="Right"
                                       Visibility="{Binding IsCharging, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,6">
                            <TextBlock Text="{Binding BatteryText}" Style="{DynamicResource Numeric}" FontSize="24" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding BatteryDetailText}" FontSize="10" Foreground="{DynamicResource MutedBrush}"
                                       VerticalAlignment="Bottom" Margin="10,0,0,6" />
                        </StackPanel>
                        <ProgressBar Style="{DynamicResource SlimProgress}" Value="{Binding BatteryFraction, Mode=OneWay}" Maximum="1"
                                     Foreground="{DynamicResource SuccessBrush}" />
                    </StackPanel>
                    <StackPanel Visibility="{Binding NoBattery, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding TempLabel}" Style="{DynamicResource Muted}" />
                        <TextBlock Text="{Binding TempText}" FontSize="12" Foreground="{DynamicResource Text2Brush}" Margin="0,8,0,0" />
                        <TextBlock Text="&#xE7F8;" FontFamily="{DynamicResource GlyphFont}" FontSize="26"
                                   Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Right" Margin="0,-26,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
            <Border Style="{DynamicResource WidgetCard}" Margin="5,5,0,0">
                <StackPanel>
                    <TextBlock Text="{Binding NetLabel}" Style="{DynamicResource Muted}" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="&#xE898;" FontFamily="{DynamicResource GlyphFont}" FontSize="13"
                                   Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding DownText}" Style="{DynamicResource Numeric}" FontSize="14" Margin="6,0,0,0" />
                        <TextBlock Text="&#xE898;" FontFamily="{DynamicResource GlyphFont}" FontSize="13"
                                   Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="16,0,0,0">
                            <TextBlock.LayoutTransform>
                                <ScaleTransform ScaleY="-1" />
                            </TextBlock.LayoutTransform>
                        </TextBlock>
                        <TextBlock Text="{Binding UpText}" Style="{DynamicResource Numeric}" FontSize="14" Margin="6,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- disks + processes -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                <TextBlock Text="{Binding DiskLabel}" Style="{DynamicResource SectionTitle}" />
                <ItemsControl ItemsSource="{Binding Disks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,8">
                                <Grid>
                                    <TextBlock Text="{Binding Drive}" FontSize="11.5" Foreground="{DynamicResource TextBrush}" />
                                    <TextBlock Text="{Binding FreeText}" FontSize="10" Foreground="{DynamicResource MutedBrush}"
                                               HorizontalAlignment="Right" />
                                </Grid>
                                <ProgressBar Style="{DynamicResource SlimProgress}" Value="{Binding UsedFraction, Mode=OneWay}"
                                             Maximum="1" Margin="0,4,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                <TextBlock Text="{Binding TopProcessesLabel}" Style="{DynamicResource SectionTitle}" />
                <ItemsControl ItemsSource="{Binding TopProcesses}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <TextBlock Text="{Binding Name}" FontSize="11.5" Foreground="{DynamicResource Text2Brush}"
                                           TextTrimming="CharacterEllipsis" MaxWidth="180" HorizontalAlignment="Left" />
                                <TextBlock Text="{Binding CpuText}" Style="{DynamicResource Numeric}" FontSize="11.5"
                                           HorizontalAlignment="Right" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding ProcessesNote}" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,0" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
