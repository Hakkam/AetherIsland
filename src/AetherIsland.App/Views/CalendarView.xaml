<UserControl x:Class="AetherIsland.App.Views.CalendarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Margin="2,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- week strip -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" CornerRadius="12" Padding="12,9"
                BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1">
            <ItemsControl ItemsSource="{Binding WeekDays}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="7" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{Binding DayName}" FontSize="9.5" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource MutedBrush}" />
                            <Border CornerRadius="9" Padding="9,2" Margin="0,3,0,0" HorizontalAlignment="Center"
                                    Background="Transparent"
                                    BorderBrush="Transparent" BorderThickness="2">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentDynamicBrush}" />
                                                <Setter Property="Background" Value="#1F32A8FF" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding DayNumber}" FontSize="13" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextBrush}" />
                            </Border>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!-- upcoming -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
            <StackPanel>
                <TextBlock Text="{Binding UpcomingTitle}" Style="{DynamicResource SectionTitle}" />

                <!-- no accounts -->
                <Border Visibility="{Binding NoAccounts, Converter={StaticResource BoolToVis}}"
                        Background="{DynamicResource SurfaceBrush}" CornerRadius="12" Padding="20"
                        BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" Margin="0,8">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="&#xE787;" FontFamily="{DynamicResource GlyphFont}" FontSize="28"
                                   Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding NoAccountsText}" FontSize="12" Foreground="{DynamicResource Text2Brush}"
                                   HorizontalAlignment="Center" Margin="0,8,0,0" />
                        <Button Style="{DynamicResource PrimaryButton}" Content="{Binding AddIcsLabel}"
                                Command="{Binding AddIcsCommand}" Margin="0,12,0,0" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- no events -->
                <TextBlock Text="{Binding EmptyText}" FontSize="12" Foreground="{DynamicResource Text2Brush}"
                           HorizontalAlignment="Center" Margin="0,24,0,0"
                           Visibility="{Binding EmptyVisible, Converter={StaticResource BoolToVis}}" />

                <ItemsControl ItemsSource="{Binding Events}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="12,9"
                                    BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" Margin="0,0,0,7">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding StartText}" Style="{DynamicResource Numeric}" FontSize="12.5" />
                                        <TextBlock Text="{Binding DateText}" FontSize="9.5" Foreground="{DynamicResource MutedBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="10,0,8,0">
                                        <TextBlock Text="{Binding Title}" FontSize="12.5" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextBrush}" MaxWidth="380" />
                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                            <TextBlock Text="{Binding RelativeText}" FontSize="10" Foreground="{DynamicResource MutedBrush}" />
                                            <TextBlock Text="{Binding Location}" FontSize="10" Foreground="{DynamicResource MutedBrush}"
                                                       Margin="10,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="220" />
                                        </StackPanel>
                                    </StackPanel>
                                    <Button Grid.Column="2" Style="{DynamicResource GhostButton}" Content="{Binding JoinLabel}"
                                            Command="{Binding DataContext.JoinCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" Padding="10,4" FontSize="10.5"
                                            Visibility="{Binding HasJoin, Converter={StaticResource BoolToVis}}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- footer -->
        <StackPanel Grid.Row="2" Margin="0,8,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBox Width="230" Text="{Binding SourceUrl, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="{Binding SourceUrlHint}" />
                <Button Style="{DynamicResource GhostButton}" Content="{Binding AddUrlLabel}"
                        Command="{Binding AddUrlCommand}" Padding="10,5" Margin="4,0,0,0" />
                <TextBlock Text="{Binding CalendarStatus}" Foreground="{DynamicResource WarningBrush}"
                           VerticalAlignment="Center" Margin="8,0,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,0,0">
                <Button Style="{DynamicResource GhostButton}" Content="{Binding ConnectGoogleLabel}"
                        Command="{Binding ConnectGoogleCommand}" Padding="8,5" Margin="3,0" />
                <Button Style="{DynamicResource GhostButton}" Content="{Binding ConnectMicrosoftLabel}"
                        Command="{Binding ConnectMicrosoftCommand}" Padding="8,5" Margin="3,0" />
                <Button Style="{DynamicResource GhostButton}" Content="{Binding DisconnectGoogleLabel}"
                        Command="{Binding DisconnectGoogleCommand}" Padding="8,5" Margin="3,0"
                        Visibility="{Binding GoogleConnected, Converter={StaticResource BoolToVis}}" />
                <Button Style="{DynamicResource GhostButton}" Content="{Binding DisconnectMicrosoftLabel}"
                        Command="{Binding DisconnectMicrosoftCommand}" Padding="8,5" Margin="3,0"
                        Visibility="{Binding MicrosoftConnected, Converter={StaticResource BoolToVis}}" />
            <Button Style="{DynamicResource IconButton}" Content="&#xE72C;" Command="{Binding RefreshCommand}" />
            <Button Style="{DynamicResource GhostButton}" Content="{Binding AddIcsLabel}"
                    Command="{Binding AddIcsCommand}" Padding="10,5" FontSize="11" Margin="4,0,0,0" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
