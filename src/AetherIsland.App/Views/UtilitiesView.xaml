<UserControl x:Class="AetherIsland.App.Views.UtilitiesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="ActionTile" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="11" Padding="8">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{TemplateBinding Tag}" FontFamily="{DynamicResource GlyphFont}"
                                           FontSize="17" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource AccentDynamicBrush}" />
                                <TextBlock Text="{TemplateBinding Content}" HorizontalAlignment="Center" Margin="0,5,0,0"
                                           TextWrapping="Wrap" TextAlignment="Center" MaxWidth="96" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="2,2">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- action tiles -->
        <UniformGrid Grid.Row="0" Columns="4" HorizontalAlignment="Center">
            <Button Style="{StaticResource ActionTile}" Tag="&#xE7A8;" Content="{Binding ScreenshotLabel}"
                    Command="{Binding ScreenshotCommand}" Margin="4" />
            <Button Style="{StaticResource ActionTile}" Tag="&#xE72E;" Content="{Binding LockLabel}"
                    Command="{Binding LockCommand}" Margin="4" />
            <Button Style="{StaticResource ActionTile}" Tag="&#xE9D5;" Content="{Binding TaskManagerLabel}"
                    Command="{Binding TaskManagerCommand}" Margin="4" />
            <Button Style="{StaticResource ActionTile}" Tag="&#xE8B7;" Content="{Binding ExplorerLabel}"
                    Command="{Binding ExplorerCommand}" Margin="4" />
            <Button Style="{StaticResource ActionTile}" Tag="&#xE713;" Content="{Binding SettingsLabel}"
                    Command="{Binding SettingsCommand}" Margin="4" />
            <Button Style="{StaticResource ActionTile}" Tag="&#xE74D;" Content="{Binding EmptyBinLabel}"
                    Command="{Binding EmptyBinCommand}" Margin="4" />
            <Button Style="{StaticResource ActionTile}" Tag="&#xE708;" Content="{Binding KeepAwakeLabel}"
                    Command="{Binding KeepAwakeCommand}" Margin="4" />
        </UniformGrid>

        <!-- calculator -->
        <Border Grid.Row="1" Style="{DynamicResource WidgetCard}" Margin="0,10,0,0" Padding="12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding CalculatorLabel}" Style="{DynamicResource Muted}" VerticalAlignment="Center" />
                <TextBox Text="{Binding CalcExpression, UpdateSourceTrigger=PropertyChanged}" Width="220" Margin="12,0,8,0"
                         FontFamily="{DynamicResource NumericFont}" />
                <Button Style="{DynamicResource PrimaryButton}" Content="{Binding EvalLabel}"
                        Command="{Binding EvalCommand}" Padding="10,5" />
                <TextBlock Text="{Binding CalcResult}" Style="{DynamicResource Numeric}" FontSize="16"
                           VerticalAlignment="Center" Margin="14,0,0,0" MaxWidth="180"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Border>

        <!-- favorites -->
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                <Grid>
                    <TextBlock Text="{Binding FoldersLabel}" Style="{DynamicResource SectionTitle}" />
                    <Button Style="{DynamicResource IconButton}" Content="&#xE710;" HorizontalAlignment="Right"
                            Command="{Binding AddFolderCommand}" ToolTip="{Binding AddFolderLabel}" />
                </Grid>
                <ItemsControl ItemsSource="{Binding Folders}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{DynamicResource GhostButton}" Content="{Binding Name}" Padding="9,5" FontSize="11"
                                    HorizontalContentAlignment="Left" Margin="0,0,0,4"
                                    Command="{Binding DataContext.OpenItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                <TextBlock Text="{Binding WebsitesLabel}" Style="{DynamicResource SectionTitle}" />
                <ItemsControl ItemsSource="{Binding Websites}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{DynamicResource GhostButton}" Content="{Binding Name}" Padding="9,5" FontSize="11"
                                    HorizontalContentAlignment="Left" Margin="0,0,0,4"
                                    Command="{Binding DataContext.OpenLinkCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
