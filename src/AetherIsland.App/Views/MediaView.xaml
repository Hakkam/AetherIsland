<UserControl x:Class="AetherIsland.App.Views.MediaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Background="Transparent">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="265" />
        </Grid.ColumnDefinitions>
        <!-- empty state -->
        <StackPanel Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{Binding EmptyVisible, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="&#xE8D6;" FontFamily="{DynamicResource GlyphFont}" FontSize="34"
                       Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" />
            <TextBlock Text="{Binding EmptyText}" FontSize="12" Foreground="{DynamicResource Text2Brush}"
                       HorizontalAlignment="Center" Margin="0,10,0,0" />
        </StackPanel>

        <!-- session -->
        <StackPanel Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520"
                    Visibility="{Binding HasSession, Converter={StaticResource BoolToVis}}">
            <Grid HorizontalAlignment="Center" Margin="0,0,0,14">
                <Border Width="96" Height="96" CornerRadius="12" Background="{DynamicResource Surface2Brush}">
                    <Image Source="{Binding AlbumArt}" Stretch="UniformToFill" />
                </Border>
                <TextBlock Text="&#xE8D6;" FontFamily="{DynamicResource GlyphFont}" FontSize="34"
                           Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="{Binding NoArt, Converter={StaticResource BoolToVis}}" />
            </Grid>

            <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center" MaxWidth="480" />
            <TextBlock Text="{Binding ArtistLine}" FontSize="11.5" Foreground="{DynamicResource Text2Brush}"
                       HorizontalAlignment="Center" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" MaxWidth="480" />

            <ProgressBar Style="{DynamicResource SlimProgress}" Value="{Binding ProgressFraction, Mode=OneWay}"
                         Maximum="1" Margin="0,16,0,4" Width="380" />
            <Grid Width="380">
                <TextBlock Text="{Binding PositionText}" Style="{DynamicResource Muted}" FontSize="10" />
                <TextBlock Text="{Binding DurationText}" Style="{DynamicResource Muted}" FontSize="10" HorizontalAlignment="Right" />
            </Grid>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                <Button Style="{DynamicResource IconButton}" Content="&#xE892;" FontSize="17" Width="46" Height="38"
                        Command="{Binding PrevCommand}" />
                <Button Style="{DynamicResource IconButton}" Content="{Binding PlaybackGlyph}" FontSize="19" Width="52" Height="42"
                        Command="{Binding PlayPauseCommand}" Margin="8,0" />
                <Button Style="{DynamicResource IconButton}" Content="&#xE892;" FontSize="17" Width="46" Height="38"
                        Command="{Binding NextCommand}">
                    <Button.LayoutTransform>
                        <ScaleTransform ScaleX="-1" />
                    </Button.LayoutTransform>
                </Button>
            </StackPanel>
        </StackPanel>
        <!-- Optional local webcam mirror. Video starts only after a user click;
             the reader is released immediately when this module is hidden. -->
        <Border Grid.Column="1" Margin="8,4,0,4" CornerRadius="14"
                Padding="12" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="{Binding CameraTitle}" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}"/>
                <Border Grid.Row="1" Margin="0,10" CornerRadius="11" ClipToBounds="True"
                        Background="{DynamicResource Surface2Brush}">
                    <Grid>
                        <TextBlock Text="&#xE714;" FontFamily="{DynamicResource GlyphFont}"
                                   Foreground="{DynamicResource MutedBrush}" FontSize="32"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Image Source="{Binding CameraFrame}" Stretch="UniformToFill"
                               RenderTransformOrigin="0.5,0.5">
                            <Image.RenderTransform>
                                <ScaleTransform ScaleX="-1"/>
                            </Image.RenderTransform>
                        </Image>
                    </Grid>
                </Border>
                <TextBlock Grid.Row="2" Text="{Binding CameraStatus}" FontSize="10"
                           TextWrapping="Wrap" Foreground="{DynamicResource Text2Brush}" Margin="0,0,0,8"/>
                <Button Grid.Row="3" Content="{Binding CameraActionLabel}"
                        Command="{Binding ToggleCameraCommand}"
                        Style="{DynamicResource GhostButton}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
