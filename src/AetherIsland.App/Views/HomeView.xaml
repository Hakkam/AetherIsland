<UserControl x:Class="AetherIsland.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="Transparent">
        <StackPanel Margin="4,2,4,4">

            <Grid Margin="2,2,2,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Greeting}" FontSize="17" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}" />
                <TextBlock Grid.Column="1" Text="{Binding DateShell}" VerticalAlignment="Center"
                           Style="{DynamicResource Subtle}" />
            </Grid>

            <UniformGrid Columns="3" Margin="0,0,0,10">
                <!-- weather snapshot -->
                <Border Style="{DynamicResource WidgetCard}" Margin="0,0,6,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding WeatherGlyph}" FontFamily="{DynamicResource GlyphFont}"
                                   FontSize="26" Foreground="{DynamicResource WarningBrush}"
                                   VerticalAlignment="Center" Margin="0,0,12,0" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding WeatherSummary}" FontSize="12.5" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextBrush}" MaxWidth="180" />
                            <TextBlock Text="{Binding WeatherTitle}" Style="{DynamicResource Muted}" Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- next event -->
                <Border Style="{DynamicResource WidgetCard}" Margin="3,0">
                    <StackPanel>
                        <TextBlock Text="{Binding NextEventTitle}" Style="{DynamicResource Muted}" />
                        <TextBlock Text="{Binding NextEventText}" FontSize="12.5" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextBrush}" Margin="0,4,0,0" MaxWidth="180" />
                    </StackPanel>
                </Border>

                <!-- AI summary -->
                <Border Style="{DynamicResource WidgetCard}" Margin="6,0,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="{DynamicResource AiBrush}"
                                     VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding AiTitle}" Style="{DynamicResource Muted}" />
                        </StackPanel>
                        <TextBlock Text="{Binding AiSummary}" FontSize="12.5" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextBrush}" Margin="0,4,0,0" MaxWidth="180" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- quick actions -->
            <TextBlock Text="{Binding QuickActionsTitle}" Style="{DynamicResource SectionTitle}" Margin="2,0,0,6" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <ItemsControl ItemsSource="{Binding QuickActions}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{DynamicResource GhostButton}" Margin="0,0,8,0" Padding="12,6"
                                    Command="{Binding RunCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Glyph}" FontFamily="{DynamicResource GlyphFont}"
                                               FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Label}" Margin="7,0,0,0" FontSize="11.5" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- media + focus row -->
            <UniformGrid Columns="2" Margin="0,0,0,10">
                <Border Style="{DynamicResource WidgetCard}" Margin="0,0,6,0" Visibility="{Binding HasMedia, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE768;" FontFamily="{DynamicResource GlyphFont}" FontSize="20"
                                   Foreground="{DynamicResource AccentDynamicBrush}" VerticalAlignment="Center"
                                   Margin="0,0,10,0" />
                        <StackPanel>
                            <TextBlock Text="{Binding NowPlayingTitle}" Style="{DynamicResource Muted}" />
                            <TextBlock Text="{Binding MediaText}" FontSize="12" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextBrush}" MaxWidth="220" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Style="{DynamicResource WidgetCard}" Margin="6,0,0,0" Visibility="{Binding HasFocus, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE9D5;" FontFamily="{DynamicResource GlyphFont}" FontSize="20"
                                   Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center"
                                   Margin="0,0,10,0" />
                        <StackPanel>
                            <TextBlock Text="{Binding FocusTitle}" Style="{DynamicResource Muted}" />
                            <TextBlock Text="{Binding FocusText}" FontSize="12" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextBrush}" MaxWidth="220" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- recent tasks -->
            <TextBlock Text="{Binding RecentTasksTitle}" Style="{DynamicResource SectionTitle}" Margin="2,0,0,6" />
            <ItemsControl ItemsSource="{Binding RecentTasks}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource Surface2Brush}" CornerRadius="8" Padding="10,6"
                                Margin="0,0,0,4">
                            <TextBlock Text="{Binding Title}" FontSize="12" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextBrush}" MaxWidth="600" />
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
