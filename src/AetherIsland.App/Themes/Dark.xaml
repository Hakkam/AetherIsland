<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Aether Island — dark palette (spec §5) -->
    <Color x:Key="BgColor">#101216</Color>
    <Color x:Key="SurfaceColor">#191D24</Color>
    <Color x:Key="Surface2Color">#232832</Color>
    <Color x:Key="HoverColor">#303642</Color>
    <Color x:Key="TextColor">#F5F7FA</Color>
    <Color x:Key="Text2Color">#A5ADBA</Color>
    <Color x:Key="MutedColor">#737D8D</Color>
    <Color x:Key="AccentColor">#32A8FF</Color>
    <Color x:Key="AiColor">#A58BFF</Color>
    <Color x:Key="SuccessColor">#36C797</Color>
    <Color x:Key="WarningColor">#F2B45C</Color>
    <Color x:Key="DangerColor">#FF6878</Color>
    <Color x:Key="StrokeColor">#2A2F3A</Color>

    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="Surface2Brush" Color="{StaticResource Surface2Color}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource HoverColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="Text2Brush" Color="{StaticResource Text2Color}" />
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AiBrush" Color="{StaticResource AiColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="StrokeBrush" Color="{StaticResource StrokeColor}" />

    <!-- Accent color is re-pointable at runtime; AccentDynamicBrush is what controls bind to. -->
    <SolidColorBrush x:Key="AccentDynamicBrush" Color="{StaticResource AccentColor}" />

    <sys:Double x:Key="OuterCornerRadius">24</sys:Double>
    <sys:Double x:Key="WidgetCornerRadius">14</sys:Double>
    <sys:Double x:Key="ButtonCornerRadius">11</sys:Double>

    <FontFamily x:Key="UiFont">Segoe UI Variable Display, Segoe UI, Segoe UI Variable Text</FontFamily>
    <FontFamily x:Key="GlyphFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="NumericFont">Segoe UI Variable Display, Consolas</FontFamily>

    <sys:Double x:Key="PanelOpacity">1</sys:Double>

</ResourceDictionary>
