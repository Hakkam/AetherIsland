<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Aether Island — light palette -->
    <Color x:Key="BgColor">#F4F6F9</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="Surface2Color">#EDF0F4</Color>
    <Color x:Key="HoverColor">#E2E7EE</Color>
    <Color x:Key="TextColor">#14181F</Color>
    <Color x:Key="Text2Color">#48505C</Color>
    <Color x:Key="MutedColor">#7A8290</Color>
    <Color x:Key="AccentColor">#2A8FE0</Color>
    <Color x:Key="AiColor">#7B5CE6</Color>
    <Color x:Key="SuccessColor">#1FA97E</Color>
    <Color x:Key="WarningColor">#D99425</Color>
    <Color x:Key="DangerColor">#E14B5A</Color>
    <Color x:Key="StrokeColor">#D8DDE4</Color>

    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="Surface2Brush" Color="{StaticResource Surface2Color}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource HoverColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="Text2Brush" Color="{StaticResource Text2Color}" />
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AiBrush" Color="{StaticResource AiColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="StrokeBrush" Color="{StaticResource StrokeColor}" />

    <SolidColorBrush x:Key="AccentDynamicBrush" Color="{StaticResource AccentColor}" />

    <sys:Double x:Key="OuterCornerRadius">24</sys:Double>
    <sys:Double x:Key="WidgetCornerRadius">14</sys:Double>
    <sys:Double x:Key="ButtonCornerRadius">11</sys:Double>

    <FontFamily x:Key="UiFont">Segoe UI Variable Display, Segoe UI, Segoe UI Variable Text</FontFamily>
    <FontFamily x:Key="GlyphFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="NumericFont">Segoe UI Variable Display, Consolas</FontFamily>

    <sys:Double x:Key="PanelOpacity">1</sys:Double>

</ResourceDictionary>
