<Window x:Class="AetherIsland.App.Windows.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AetherIsland.App.ViewModels"
        xmlns:views="clr-namespace:AetherIsland.App.Views"
        xmlns:infra="clr-namespace:AetherIsland.App.Infrastructure"
        Title="Aether Island"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Width="860" Height="430">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <infra:BooleanToBrushConverter x:Key="BoolToBrush" />
        <DataTemplate DataType="{x:Type vm:HomeViewModel}"><views:HomeView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><views:DashboardView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:FileShelfViewModel}"><views:FileShelfView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:TasksViewModel}"><views:TasksView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:NotesViewModel}"><views:NotesView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:FocusViewModel}"><views:FocusView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:MediaViewModel}"><views:MediaView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:CalendarViewModel}"><views:CalendarView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:WeatherViewModel}"><views:WeatherView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProductivityViewModel}"><views:ProductivityView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:NetworkViewModel}"><views:NetworkView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SystemViewModel}"><views:SystemView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:WellbeingViewModel}"><views:WellbeingView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:AiCenterViewModel}"><views:AiCenterView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:UtilitiesViewModel}"><views:UtilitiesView /></DataTemplate>
    </Window.Resources>

    <Border x:Name="RootBorder"
            Background="{DynamicResource BgBrush}"
            CornerRadius="{DynamicResource OuterCornerRadius}"
            BorderBrush="{DynamicResource StrokeBrush}"
            BorderThickness="1"
            Opacity="{DynamicResource PanelOpacity}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="2" Opacity="0.42" />
        </Border.Effect>

        <Grid>
            <!-- ============ Expanded ============ -->
            <Grid x:Name="ExpandedRoot" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- navigation rail -->
                <Border Grid.Row="0" Padding="8,7,8,2"
                        MouseLeftButtonDown="Rail_MouseLeftButtonDown"
                        Background="Transparent">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="NavList" ItemsSource="{Binding NavItems}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <RadioButton Style="{DynamicResource NavItem}"
                                                     GroupName="nav"
                                                     Content="{Binding Glyph}"
                                                     ToolTip="{Binding Label}"
                                                     IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                     Tag="{Binding IsAiAccent, Converter={StaticResource BoolToBrush}}"
                                                     Command="{Binding DataContext.NavigateToCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                     CommandParameter="{Binding Id}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="6,0,2,0">
                            <TextBlock Text="⠿" FontSize="17" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Text2Brush}" VerticalAlignment="Center"
                                       Cursor="SizeAll" ToolTip="Drag island to move"
                                       Margin="0,0,9,0" MouseLeftButtonDown="Rail_MouseLeftButtonDown" />
                            <Button Style="{DynamicResource IconButton}" Content="&#xE77A;"
                                    ToolTip="{Binding PinLabel}" Click="Pin_Click" x:Name="PinButton" />
                            <Button Style="{DynamicResource IconButton}" Content="&#xE713;"
                                    ToolTip="{Binding SettingsLabel}" Click="Settings_Click" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- module content -->
                <ContentControl Grid.Row="1" Content="{Binding Current}" Margin="10,4,10,10"
                                Focusable="False" />
            </Grid>

            <!-- ============ Collapsed pill ============ -->
            <Border x:Name="PillRoot" Height="40" Margin="5" CornerRadius="16"
                    Background="Transparent" Cursor="Hand"
                    MouseLeftButtonDown="Pill_MouseLeftButtonDown"
                    MouseLeftButtonUp="Pill_MouseLeftButtonUp"
                    MouseMove="Pill_MouseMove">
                <Grid Margin="14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{Binding ClockText}"
                               FontFamily="{DynamicResource NumericFont}" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />

                    <TextBlock Grid.Column="1" Text="{Binding PillStatusGlyph}"
                               FontFamily="{DynamicResource GlyphFont}" FontSize="11" Margin="8,0,0,0"
                               Foreground="{DynamicResource AccentDynamicBrush}" VerticalAlignment="Center"
                               Visibility="{Binding HasContextEvent, Converter={StaticResource BoolToVis}}" />

                    <TextBlock Grid.Column="2" Text="{Binding PillStatusText}" Margin="7,0,0,0"
                               FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                               Foreground="{DynamicResource Text2Brush}" />

                    <Ellipse Grid.Column="3" Width="7" Height="7" Margin="6,0,0,0"
                             Fill="{DynamicResource AiBrush}" VerticalAlignment="Center"
                             ToolTip="{Binding AiStatusText}">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AiStatusText}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
