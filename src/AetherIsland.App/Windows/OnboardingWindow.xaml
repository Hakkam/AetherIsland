<Window x:Class="AetherIsland.App.Windows.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aether Island"
        Width="560" Height="460"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="ToolWindow"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{DynamicResource UiFont}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="Combo" TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource Surface2Brush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="MinWidth" Value="160" />
        </Style>
        <Style x:Key="CheckRow" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
    </Window.Resources>

    <Grid Margin="30,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="&#xE7E1;" FontFamily="{DynamicResource GlyphFont}" FontSize="34"
                       Foreground="{DynamicResource AccentDynamicBrush}" Margin="0,0,0,14" />
            <TextBlock Text="{Binding CurrentStep.Title}" FontSize="19" FontWeight="SemiBold" />
            <TextBlock Text="{Binding CurrentStep.Body}" FontSize="12.5" TextWrapping="Wrap"
                       Foreground="{DynamicResource Text2Brush}" Margin="0,10,0,0" MaxWidth="470"
                       HorizontalAlignment="Left" />

            <!-- appearance step -->
            <StackPanel Margin="0,18,0,0" Visibility="{Binding ShowAppearance, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="{Binding ThemeLabel}" FontSize="12" Foreground="{DynamicResource Text2Brush}"
                               Width="90" VerticalAlignment="Center" />
                    <ComboBox Style="{StaticResource Combo}" ItemsSource="{Binding Themes}"
                              SelectedItem="{Binding SelectedTheme, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding LanguageLabel}" FontSize="12" Foreground="{DynamicResource Text2Brush}"
                               Width="90" VerticalAlignment="Center" />
                    <ComboBox Style="{StaticResource Combo}" ItemsSource="{Binding Languages}"
                              SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}" SelectionChanged="Language_Changed" />
                </StackPanel>
            </StackPanel>

            <!-- behavior step -->
            <StackPanel Margin="0,18,0,0" Visibility="{Binding ShowBehavior, Converter={StaticResource BoolToVis}}">
                <CheckBox Style="{StaticResource CheckRow}" Content="{Binding HideFullscreenLabel}"
                          IsChecked="{Binding HideInFullscreen, Mode=TwoWay}" />
                <CheckBox Style="{StaticResource CheckRow}" Content="{Binding CollapseLabel}"
                          IsChecked="{Binding CollapseOnDeactivate, Mode=TwoWay}" />
            </StackPanel>

            <!-- privacy step -->
            <StackPanel Margin="0,18,0,0" Visibility="{Binding ShowPrivacy, Converter={StaticResource BoolToVis}}">
                <CheckBox Style="{StaticResource CheckRow}" Content="{Binding ScreenTimeLabel}"
                          IsChecked="{Binding ScreenTimeConsent, Mode=TwoWay}" />
                <CheckBox Style="{StaticResource CheckRow}" Content="{Binding AgentMetaLabel}"
                          IsChecked="{Binding AgentMetaConsent, Mode=TwoWay}" />
            </StackPanel>

            <!-- done step -->
            <Border Margin="0,18,0,0" Visibility="{Binding ShowDone, Converter={StaticResource BoolToVis}}"
                    Background="{DynamicResource SurfaceBrush}" CornerRadius="12" Padding="14"
                    BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE930;" FontFamily="{DynamicResource GlyphFont}" FontSize="20"
                               Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding HotkeyHintText}" FontSize="12.5" Margin="10,0,0,0"
                               Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </StackPanel>

        <DockPanel Grid.Row="1" Margin="0,18,0,0">
            <Button Style="{DynamicResource GhostButton}" Content="{Binding SkipLabel}" Command="{Binding SkipCommand}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{DynamicResource GhostButton}" Content="{Binding BackLabel}" Command="{Binding BackCommand}" Margin="0,0,8,0" />
                <Button Style="{DynamicResource PrimaryButton}" Content="{Binding NextLabel}" Command="{Binding NextCommand}" MinWidth="96" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
