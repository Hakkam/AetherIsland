<Window x:Class="AetherIsland.App.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aether Island — Settings"
        Width="640" Height="700"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{DynamicResource UiFont}">
    <Window.Resources>
        <Style x:Key="Row" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
        <Style x:Key="SettingLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource Text2Brush}" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Margin" Value="0,4,0,12" />
        </Style>
        <Style x:Key="CheckRow" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="Combo" TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource Surface2Brush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="MinWidth" Value="160" />
        </Style>
    </Window.Resources>

    <Grid Margin="20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="{Binding SettingsTitle}" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,4" />
        <TextBlock Grid.Row="0" Text="Aether Island" FontSize="11" Foreground="{DynamicResource MutedBrush}"
                   HorizontalAlignment="Right" VerticalAlignment="Bottom" />

        <ScrollViewer x:Name="SettingsScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,12">
            <StackPanel>

                <!-- ===== General ===== -->
                <TextBlock Text="{Binding GeneralTitle}" Style="{StaticResource SectionHeader}" />
                <StackPanel Style="{StaticResource Row}" Orientation="Horizontal">
                    <TextBlock Text="{Binding LanguageLabel}" Style="{StaticResource SettingLabel}" VerticalAlignment="Center" Margin="0,0,10,0" Width="120" />
                    <ComboBox Style="{StaticResource Combo}" ItemsSource="{Binding Languages}"
                              SelectedItem="{Binding S.General.Language, Mode=TwoWay}" SelectionChanged="OnChanged" />
                </StackPanel>
                <CheckBox Style="{StaticResource CheckRow}" Content="{Binding StartupLabel}"
                          IsChecked="{Binding S.General.StartWithWindows, Mode=TwoWay}" Checked="OnChanged" Unchecked="OnChanged" />
                <TextBlock Text="{Binding StartupDesc}" Style="{DynamicResource Muted}" Margin="0,0,0,14" />

                <!-- ===== Appearance ===== -->
                <TextBlock Text="{Binding AppearanceTitle}" Style="{StaticResource SectionHeader}" />
                <StackPanel Style="{StaticResource Row}" Orientation="Horizontal">
                    <TextBlock Text="{Binding ThemeLabel}" Style="{StaticResource SettingLabel}" VerticalAlignment="Center" Margin="0,0,10,0" Width="120" />
                    <ComboBox Style="{StaticResource Combo}" ItemsSource="{Binding Themes}"
                              SelectedItem="{Binding S.Appearance.Theme, Mode=TwoWay}" SelectionChanged="OnChanged" />
                </StackPanel>
                <StackPanel Style="{StaticResource Row}" Orientation="Horizontal">
                    <TextBlock Text="{Binding AccentLabel}" Style="{StaticResource SettingLabel}" VerticalAlignment="Center" Margin="0,0,10,0" Width="120" />
                    <TextBox Text="{Binding S.Appearance.AccentHex, Mode=TwoWay}" Width="110" LostFocus="OnChanged" />
                </StackPanel>
                <StackPanel Style="{StaticResource Row}" Orientation="Horizontal">
                    <TextBlock Text="{Binding CornerLabel}" Style="{StaticResource SettingLabel}" VerticalAlignment="Center" Margin="0,0,10,0" Width="120" />
                    <Slider Minimum="12" Maximum="32" Width="220" Value="{Binding S.Appearance.CornerRadius, Mode=TwoWay}"
                            ValueChanged="OnChanged" IsSnapToTickEnabled="True" TickFrequency="2" />
                    <TextBlock Text="{Binding S.Appearance.CornerRadius}" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Style="{StaticResource Row}" Orientation="Horizontal">
                    <TextBlock Text="{Binding WidthLabel}" Style="{StaticResource SettingLabel}" VerticalAlignment="Center" Margin="0,0,10,0" Width="120" />
                    <Slider Minimum="700" Maximum="1100" Width="220" Value="{Binding S.Appearance.ExpandedWidth, Mode=TwoWay}"
                            ValueChanged="OnChanged" IsSnapToTickEnabled="True" TickFrequency="10" />
                </StackPanel>
                <StackPanel Style="{StaticResource Row}" Orientation="Horizontal">
                    <TextBlock Text="{Binding HeightLabel}" Style="{StaticResource SettingLabel}" VerticalAlignment="Center" Margin="0,0,10,0" Width="120" />
                    <Slider Minimum="340" Maximum="620" Width="220" Value="{Binding S.Appearance.ExpandedHeight, Mode=TwoWay}"
                            ValueChanged="OnChanged" IsSnapToTickEnabled="True" TickFrequency="10" />
                </StackPanel>

                <!-- ===== Island behavior ===== -->
                <TextBlock Text="{Binding IslandTitle}" Style="{StaticResource SectionHeader}" />
                <CheckBox Style="{StaticResource CheckRow}" Content="{Binding CollapseLabel}"
                          IsChecked="{Binding S.Behavior.CollapseOnDeactivate, Mode=TwoWay}" Checked="OnChanged" Unchecked="OnChanged" />
                <CheckBox Style="{StaticResource CheckRow}" Content="{Binding FullscreenLabel}"
                          IsChecked="{Binding HideInFullscreen, Mode=TwoWay}" Checked="OnChanged" Unchecked="OnChanged" />

                <StackPanel Style="{StaticResource Row}" Orientation="Horizontal">
                    <TextBlock Text="{Binding MonitorLabel}" Style="{StaticResource SettingLabel}"
                               VerticalAlignment="Center" Width="120" Margin="0,0,10,0" />
                    <ComboBox Style="{StaticResource Combo}" ItemsSource="{Binding MonitorOptions}"
                              SelectedItem="{Binding SelectedMonitor, Mode=TwoWay}" SelectionChanged="OnChanged" />
                </StackPanel>

                <!-- ===== Dashboard widgets ===== -->
                <TextBlock Text="{Binding DashboardTitle}" Style="{StaticResource SectionHeader}" />
                <TextBlock Text="{Binding WidgetHint}"
                           Style="{DynamicResource Muted}" Margin="0,0,0,10" />
                <ItemsControl ItemsSource="{Binding WidgetRows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Content="{Binding Label}" IsChecked="{Binding IsVisible, Mode=TwoWay}"
                                          IsEnabled="{Binding CanHide}" VerticalAlignment="Center"
                                          Foreground="{DynamicResource TextBrush}" />
                                <Button Grid.Column="1" Content="↑" Style="{DynamicResource GhostButton}"
                                        Command="{Binding MoveUpCommand}" Padding="7,3" Margin="4,0"
                                        AutomationProperties.Name="{Binding MoveUpLabel}" />
                                <Button Grid.Column="2" Content="↓" Style="{DynamicResource GhostButton}"
                                        Command="{Binding MoveDownCommand}" Padding="7,3"
                                        AutomationProperties.Name="{Binding MoveDownLabel}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="{Binding ResetWidgetsLabel}" Style="{DynamicResource GhostButton}"
                        Command="{Binding ResetWidgetsCommand}" HorizontalAlignment="Left" Margin="0,6,0,14" />

                <!-- ===== Modules ===== -->
                <TextBlock Text="{Binding ModulesTitle}" Style="{StaticResource SectionHeader}" />
                <TextBlock Text="{Binding ModuleHint}"
                           Style="{DynamicResource Muted}" Margin="0,0,0,10" />
                <ItemsControl ItemsSource="{Binding ModuleRows}" Margin="0,0,0,14">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Content="{Binding Label}" IsChecked="{Binding IsVisible, Mode=TwoWay}"
                                          IsEnabled="{Binding CanHide}" VerticalAlignment="Center"
                                          Foreground="{DynamicResource TextBrush}" />
                                <Button Grid.Column="1" Content="↑" Style="{DynamicResource GhostButton}"
                                        Command="{Binding MoveUpCommand}" Padding="7,3" Margin="4,0"
                                        AutomationProperties.Name="{Binding MoveUpLabel}" />
                                <Button Grid.Column="2" Content="↓" Style="{DynamicResource GhostButton}"
                                        Command="{Binding MoveDownCommand}" Padding="7,3"
                                        AutomationProperties.Name="{Binding MoveDownLabel}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- ===== Calendar OAuth (public desktop client IDs, no client secrets) ===== -->
                <TextBlock Text="Calendar OAuth connections" Style="{StaticResource SectionHeader}" />
                <TextBlock Text="Register a desktop OAuth client with Google Cloud or Microsoft Entra. These IDs are public; the tokens are protected by Windows DPAPI." TextWrapping="Wrap" Style="{DynamicResource Muted}" Margin="0,0,0,8" />
                <StackPanel Style="{StaticResource Row}">
                    <TextBlock Text="Google desktop client ID" Style="{StaticResource SettingLabel}" />
                    <TextBox Text="{Binding S.Calendar.GoogleClientId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextChanged="OnChanged" />
                </StackPanel>
                <StackPanel Style="{StaticResource Row}">
                    <TextBlock Text="Microsoft desktop client ID" Style="{StaticResource SettingLabel}" />
                    <TextBox Text="{Binding S.Calendar.MicrosoftClientId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextChanged="OnChanged" />
                </StackPanel>

                <!-- ===== AI providers ===== -->
                <TextBlock x:Name="AiSectionHeader" Text="{Binding AiProvidersTitle}" Style="{StaticResource SectionHeader}" />
                <ItemsControl ItemsSource="{Binding ProviderRows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="12"
                                    BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" Margin="0,0,0,8">
                                <StackPanel>
                                    <Grid>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding StatusHint}" FontSize="10" Margin="10,0,0,0"
                                                       Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Style="{DynamicResource GhostButton}" Content="{Binding TestLabel}" Padding="8,4" FontSize="10.5"
                                                    Margin="0,0,6,0" Click="OnTestProvider" />
                                            <Button Style="{DynamicResource DangerButton}" Content="{Binding RemoveLabel}" Padding="8,4" FontSize="10.5"
                                                    Command="{Binding DataContext.RemoveProviderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </Grid>
                                    <CheckBox Content="Enabled" IsChecked="{Binding Enabled, Mode=TwoWay}"
                                              Foreground="{DynamicResource Text2Brush}" FontSize="11"
                                              Checked="OnChanged" Unchecked="OnChanged" Margin="0,8,0,0" />
                                    <TextBlock Text="{Binding StatusText}" FontSize="10" TextWrapping="Wrap"
                                               Foreground="{DynamicResource Text2Brush}" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="12"
                        BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" Margin="0,4,0,8">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox Style="{StaticResource Combo}" ItemsSource="{Binding AiProviderNameOptions}"
                                      SelectedIndex="{Binding NewProviderIndex, Mode=TwoWay}" MinWidth="130" />
                            <PasswordBox x:Name="ProviderKeyBox" Grid.Column="1" Margin="8,0"
                                         PasswordChanged="ProviderKey_Changed" />
                            <Button Grid.Column="2" Style="{DynamicResource PrimaryButton}" Content="{Binding AddLabel}"
                                    Click="AddProvider_Click" />
                        </Grid>
                        <TextBlock Text="{Binding VerifiedProviderHint}"
                                   FontSize="10.5" Foreground="{DynamicResource MutedBrush}"
                                   TextWrapping="Wrap" Margin="0,8,0,0" />

                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
                    <TextBlock Text="{Binding PollLabel}" FontSize="12" Foreground="{DynamicResource Text2Brush}"
                               VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox Text="{Binding S.Ai.PollMinutes, Mode=TwoWay}" Width="50" LostFocus="OnChanged" />
                </StackPanel>

                <!-- ===== Privacy ===== -->
                <TextBlock Text="{Binding PrivacyTitle}" Style="{StaticResource SectionHeader}" />
                <CheckBox Style="{StaticResource CheckRow}" Content="{Binding ScreenTimeLabel}"
                          IsChecked="{Binding S.Privacy.ScreenTimeConsent, Mode=TwoWay}" Checked="OnChanged" Unchecked="OnChanged" />
                <CheckBox Style="{StaticResource CheckRow}" Content="{Binding AgentMetaLabel}"
                          IsChecked="{Binding S.Privacy.AgentMetadataConsent, Mode=TwoWay}" Checked="OnChanged" Unchecked="OnChanged" />
                <StackPanel Style="{StaticResource Row}" Orientation="Horizontal">
                    <TextBlock Text="{Binding RetentionLabel}" Style="{StaticResource SettingLabel}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox Text="{Binding S.Privacy.RetentionDays, Mode=TwoWay}" Width="50" LostFocus="OnChanged" />
                    <TextBlock Text="{Binding DaysLabel}" FontSize="11" Foreground="{DynamicResource Text2Brush}" VerticalAlignment="Center" Margin="6,0,0,0" />
                </StackPanel>

                <!-- ===== Shortcuts ===== -->
                <TextBlock Text="{Binding ShortcutsTitle}" Style="{StaticResource SectionHeader}" />
                <StackPanel Style="{StaticResource Row}" Orientation="Horizontal">
                    <TextBlock Text="Toggle island" Style="{StaticResource SettingLabel}" VerticalAlignment="Center" Width="150" />
                    <TextBox Text="{Binding S.Shortcuts.ToggleIsland, Mode=TwoWay}" Width="150" LostFocus="OnChanged" />
                </StackPanel>
                <StackPanel Style="{StaticResource Row}" Orientation="Horizontal">
                    <TextBlock Text="Open AI Usage" Style="{StaticResource SettingLabel}" VerticalAlignment="Center" Width="150" />
                    <TextBox Text="{Binding S.Shortcuts.OpenAiCenter, Mode=TwoWay}" Width="150" LostFocus="OnChanged" />
                </StackPanel>
                <StackPanel Style="{StaticResource Row}" Orientation="Horizontal">
                    <TextBlock Text="Open File Shelf" Style="{StaticResource SettingLabel}" VerticalAlignment="Center" Width="150" />
                    <TextBox Text="{Binding S.Shortcuts.OpenFileShelf, Mode=TwoWay}" Width="150" LostFocus="OnChanged" />
                </StackPanel>
                <StackPanel Style="{StaticResource Row}" Orientation="Horizontal">
                    <TextBlock Text="Start/pause timer" Style="{StaticResource SettingLabel}" VerticalAlignment="Center" Width="150" />
                    <TextBox Text="{Binding S.Shortcuts.StartPauseTimer, Mode=TwoWay}" Width="150" LostFocus="OnChanged" />
                </StackPanel>

                <!-- ===== Data ===== -->
                <TextBlock Text="{Binding DataTitle}" Style="{StaticResource SectionHeader}" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Button Style="{DynamicResource GhostButton}" Content="{Binding ExportLabel}" Command="{Binding ExportSettingsCommand}" Margin="0,0,8,0" />
                    <Button Style="{DynamicResource GhostButton}" Content="{Binding ImportLabel}" Command="{Binding ImportSettingsCommand}" Margin="0,0,8,0" />
                    <Button Style="{DynamicResource DangerButton}" Content="{Binding ResetLabel}" Command="{Binding ResetSettingsCommand}" />
                </StackPanel>

                <!-- ===== About ===== -->
                <TextBlock Text="{Binding AboutTitle}" Style="{StaticResource SectionHeader}" />
                <TextBlock Text="{Binding VersionText}" FontSize="12" Foreground="{DynamicResource Text2Brush}" />
                <TextBlock Text="Weather by Open-Meteo (open service) · AI usage data comes only from official provider APIs or approved local records"
                           FontSize="10.5" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>

        <DockPanel Grid.Row="2">
            <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{DynamicResource Text2Brush}"
                       VerticalAlignment="Center" />
            <Button Style="{DynamicResource PrimaryButton}" Content="Save &amp; Close" HorizontalAlignment="Right"
                    Click="SaveAndClose_Click" Padding="14,7" />
        </DockPanel>
    </Grid>
</Window>
