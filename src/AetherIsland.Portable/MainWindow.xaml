<Window x:Class="AetherIsland.Portable.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Aether Island" WindowStyle="None" AllowsTransparency="True" ResizeMode="NoResize"
 WindowStartupLocation="Manual" ShowInTaskbar="False" Topmost="True"
 FontFamily="Segoe UI"
 Width="196" Height="46" Background="Transparent">
 <Grid>
  <!-- Collapsed pill -->
  <Border x:Name="Pill" CornerRadius="20" Background="#0F1216" BorderBrush="#2A303A" BorderThickness="1" Margin="3"
   MouseLeftButtonDown="PillDown" MouseMove="PillMove" MouseLeftButtonUp="PillUp">
   <Grid x:Name="PillGrid" Margin="14,0">
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock x:Name="PillClock" Text="--:--" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" Foreground="#F2F5F9"/>
    <TextBlock x:Name="PillStatus" Grid.Column="1" Text="Aether Island" FontSize="9.5" Foreground="#8D96A6" VerticalAlignment="Center" Margin="10,0,6,0" TextTrimming="CharacterEllipsis"/>
    <Ellipse x:Name="PillDot" Grid.Column="2" Fill="#33A6F0" Width="6" Height="6" VerticalAlignment="Center"/>
   </Grid>
  </Border>
  <!-- Expanded panel -->
  <Border x:Name="Panel" CornerRadius="22" Background="#0F1216" BorderBrush="#262C36" BorderThickness="1"
   Margin="3" Visibility="Collapsed">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid Background="Transparent" MouseLeftButtonDown="HeaderDown" x:Name="HeaderBar">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel x:Name="Navigation" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0" Background="Transparent"/>
     <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0" Background="Transparent">
      <TextBlock x:Name="HeaderClock" VerticalAlignment="Center" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,9,0" Background="Transparent"/>
      <TextBlock x:Name="HeaderDate" VerticalAlignment="Center" FontSize="9.5" Margin="0,0,12,0" Background="Transparent"/>
      <Button x:Name="RefreshButton" Width="29" Height="28" Margin="1" Background="Transparent" BorderThickness="0" FocusVisualStyle="{x:Null}" ToolTip="Refresh" Click="RefreshClick"/>
      <Button x:Name="AwakeButton" Width="29" Height="28" Margin="1" Background="Transparent" BorderThickness="0" FocusVisualStyle="{x:Null}" ToolTip="Keep awake" Click="AwakeClick"/>
      <Button x:Name="SettingsButton" Width="29" Height="28" Margin="1" Background="Transparent" BorderThickness="0" FocusVisualStyle="{x:Null}" ToolTip="Settings" Click="SettingsClick"/>
     </StackPanel>
    </Grid>
    <Border Grid.Row="1" x:Name="ContentCard" Margin="10,0,10,10" Background="#14181E" CornerRadius="12">
     <ContentControl x:Name="ContentHost"/>
    </Border>
   </Grid>
  </Border>
 </Grid>
</Window>
